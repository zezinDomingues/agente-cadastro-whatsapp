{
  "name": "agente-cadastro-whatsapp",
  "version": "1.0.0",
  "private": true,
  "description": "Agente de cadastro pelo WhatsApp: qualquer formulário vira conversa, com botões, IA que entende respostas soltas e validação que não deixa dado errado passar.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "demo": "tsx demo/demo.ts",
    "chat": "tsx demo/chat.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "0.34.5",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "20.19.34",
    "typescript": "5.9.3"
  }
}
