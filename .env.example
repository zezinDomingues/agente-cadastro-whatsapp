# ── Servidor ────────────────────────────────────────────
PORT=3210
HOST=127.0.0.1
# Onde ficam conversas, cadastros e fotos (padrão: ./data)
DATA_DIR=data

# ── Formulário ─────────────────────────────────────────
# Formulário padrão (id de um arquivo em formularios/). Vazio = o primeiro da lista.
FORMULARIO=clinica
# 1 = quem escrever para o número começa o cadastro (inscrição, lead).
# 0 = só quem a sua aplicação convidou pelo POST /api/iniciar.
CADASTRO_ABERTO=1

# ── WhatsApp (Z-API) ───────────────────────────────────
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Segredo que vai na URL do webhook (a Z-API não assina o webhook).
WHATSAPP_WEBHOOK_SECRET=troque-por-um-segredo-longo
# 0 = sem os botões "beta" da Z-API (usa carrossel de 1 cartão, que funciona em qualquer instância).
ZAPI_BOTOES=1
# Testes: 1 = não manda nada (só log). Ou só para números que começam com o prefixo.
ZAPI_DRY_RUN=0
ZAPI_DRY_RUN_PREFIX=5511900000

# ── IA (qualquer API compatível com a da OpenAI) ───────
# Várias chaves separadas por vírgula: a que tomar 429 fica de castigo e a próxima assume.
LLM_API_KEYS=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Sua aplicação ──────────────────────────────────────
# Bearer das rotas /api/iniciar e /api/avisar.
API_SECRET=troque-por-um-segredo-longo
# Para onde vai o cadastro concluído (POST JSON assinado). Vazio = só data/cadastros/.
CADASTRO_WEBHOOK_URL=
CADASTRO_WEBHOOK_SEGREDO=

# ── Equipe e alertas ───────────────────────────────────
# WhatsApp da equipe: recebe as dúvidas encaminhadas e vira o botão "Falar c/ a equipe".
SUPORTE_WHATSAPP=
# Quem recebe os alarmes do vigia (mensagem não entregue, instância desconectada).
ALERTA_WHATSAPP=
VIGIA_PRAZO_MIN=3

# ── Diversos ───────────────────────────────────────────
# User-Agent do OpenStreetMap (a política de uso pede um contato).
GEO_USER_AGENT=agente-cadastro-whatsapp/1.0 (contato@seudominio.com)
CAPA_COR=#855FF3
